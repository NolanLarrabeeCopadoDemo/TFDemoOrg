<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>Product Based Routing</fullName>
        <active>true</active>
        <ruleEntry>
            <assignedTo>Hardware_Support_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Case.Product_Type__c</field>
                <operation>equals</operation>
                <value>Hardware</value>
            </criteriaItems>
            <template>unfiled$public/Case_Response_Email</template>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Software_Support_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Case.Product_Type__c</field>
                <operation>equals</operation>
                <value>Software</value>
            </criteriaItems>
            <template>unfiled$public/Case_Response_Email</template>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>Billing_Support_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Case.Product_Type__c</field>
                <operation>equals</operation>
                <value>Billing</value>
            </criteriaItems>
            <template>unfiled$public/Case_Response_Email</template>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
